   "source": [
    "# 第五题：回文数\n",
    "**题目：** 任意位数的正整数，判断它是不是回文数"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "912802f7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "这个数字是回文数\n"
     ]
    }
   ],
   "source": [
    "x = input(\"请输入一个任意位数的正整数：\")\n",
    "if x == x[::-1]:\n",
    "    print(\"这个数字是回文数\")\n",
    "else:\n",
    "    print(\"这个数字不是回文数\")"
   ]
  }
 ],
