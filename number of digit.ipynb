   "source": [
    "n=int(input())\n",
    "judge=True\n",
    "lis=[]\n",
    "while(judge):\n",
    "    if(n==0):\n",
    "        judge=False\n",
    "    else:\n",
    "        lis.append(n%10)\n",
    "        n=n//10\n",
    "print(f'位数:{len(lis)}')\n",
    "for i in lis:\n",
    "    print(i,end=\" \")"
   ]
