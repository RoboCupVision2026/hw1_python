   "source": [
    "import os\n",
    "import random\n",
    "path='img'\n",
    "lis=os.listdir(path)\n",
    "rename=random.sample(lis,50)\n",
    "for old in rename:\n",
    "    new=old.replace('.png','.jnp')\n",
    "    old_path=os.path.join(path,old)\n",
    "    new_path=os.path.join(path,new)\n",
    "    os.rename(old_path,new_path)"
   ]
  },
