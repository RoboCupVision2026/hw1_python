    "diff = []\n",
    "\n",
    "with open('test.txt','r') as f1,open('copy_test.txt','r') as f2:\n",
    "    for num,(line1,line2) in enumerate(zip(f1,f2),start = 1):\n",
    "        if line1.strip() != line2.strip():\n",
    "            diff.append(num)\n",
    "\n",
    "if len(diff) > 0:\n",
    "    print(diff)\n",
    "else:\n",
    "    print(\"一模一样\")"
   ]
  }
