   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "from random import sample\n",
    "p=Path.cwd()/\"img\"\n",
    "a=[f for f in p.glob(\"*.png\") if not f.with_suffix(\".jpg\").exists()]\n",
    "for f in sample(a,50):\n",
    "    f.rename(f.with_suffix(\".jpg\"))"
   ]
  }
