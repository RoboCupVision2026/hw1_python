   },
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "p=Path.cwd()/\"test.txt\"\n",
    "with p.open(\"r+\",encoding=\"utf-8\") as f:\n",
    "    s=f.read()\n",
    "    f.seek(0)\n",
    "    f.write(\"python\"+s+\"python\")"
   ]
  }
