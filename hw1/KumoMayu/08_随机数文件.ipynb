   "source": [
    "# 08 随机数文件\n",
    "\n",
    "题目：创建data.txt，共100000行，每行一个1到100之间的随机整数。\n",
    "\n",
    "考点：random、文件写入"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ec217c27",
   "metadata": {
