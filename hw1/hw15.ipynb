   "source": [
    "num = int(input(\"给一个任意正整数\"))\n",
    "num_copy = num\n",
    "num_turn = 0\n",
    "\n",
    "while num:\n",
    "    num_1 = num % 10\n",
    "    num_turn = num_turn * 10 + num_1\n",
    "    num = num // 10\n",
    "\n",
    "if num_turn == num_copy:\n",
    "    print(\"这是回文数\")\n",
    "else:\n",
    "    print(\"这不是回文数\")"
   ]
  }
