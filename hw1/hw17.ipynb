   "source": [
    "rest = list(range(1,234))\n",
    "idx = 0\n",
    "count = 1\n",
    "\n",
    "while len(rest) > 1:\n",
    "    if count == 3:\n",
    "        rest.pop(idx)\n",
    "        count = 1\n",
    "    else:\n",
    "        idx += 1\n",
    "        count += 1\n",
    "\n",
    "    idx = idx % len(rest)\n",
    "\n",
    "print(rest)"
   ]
  }
