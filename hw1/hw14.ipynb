    "num = int(input(\"给一个任意正整数\"))\n",
    "x = 1\n",
    "count = 1\n",
    "\n",
    "while num >= x * 10:\n",
    "    x = x * 10\n",
    "    count = count + 1\n",
    "\n",
    "print(count)\n",
    "\n",
    "while num:\n",
    "    num_1 = num % 10\n",
    "    print(num_1 , end=\"\")\n",
    "    num = num // 10"
   ]
