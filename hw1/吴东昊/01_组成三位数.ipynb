    "a=[]\n",
    "for i in range(1,5):\n",
    "    for j in range(1,5):\n",
    "        for k in range(1,5):\n",
    "            if i!=j and i!=k and j!=k:\n",
    "                a.append(i*100+j*10+k)\n",
    "print(*a)\n",
    "print(\"个数：\",len(a))"
