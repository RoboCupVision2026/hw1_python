    "from pathlib import Path\n",
    "p=Path.cwd()\n",
    "with (p/\"test.txt\").open(encoding=\"utf-8\") as f,(p/\"copy_test.txt\").open(encoding=\"utf-8\") as g:\n",
    "    a=f.readlines()\n",
    "    b=g.readlines()\n",
    "for i in range(max(len(a),len(b))):\n",
    "    if i>=len(a) or i>=len(b) or a[i]!=b[i]:\n",
    "        print(i+1)"
   ]
  }
