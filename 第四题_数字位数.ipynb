   "source": [
    "# 第四题：数字位数\n",
    "**题目：** 给一个任意位数的正整数,要求：一、求他是几位数。二、逆序打印出各位数字。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "302c1c6c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "这个数是4位数\n",
      "6789\n"
     ]
    }
   ],
   "source": [
    "x = input(\"请输入一个任意位数的正整数：\").strip()\n",
    "n = len(x)\n",
    "z = list(x)\n",
    "i = n - 1\n",
    "nixu = []\n",
    "while i >= 0:\n",
    "    nixu.append(z[i])\n",
    "    i -= 1\n",
    "print(f\"这个数是{n}位数\")\n",
    "print(*nixu,sep = \"\")\n",
    "\n",
    "\n",
    "\n"
   ]
  }
 ],
